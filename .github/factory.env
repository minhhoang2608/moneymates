# Factory limits and settings. Loaded by .github/actions/factory-setup into $GITHUB_ENV.
# Format: KEY=VALUE, one per line, no quotes, no spaces around "=". Comments start with "#".
# Changing a value here takes effect on the next workflow run once merged into dev.

# --- Escalation limits (exceeding one adds needs-human and stops the loop) ---
# Tech Lead "changes requested" rounds per ticket before a human must look.
MAX_REVIEW_ROUNDS=3
# CI failures on a PR the Dev may try to fix before escalation.
MAX_CI_FIX_ATTEMPTS=3
# Rebase attempts (conflicts with dev) per ticket before escalation.
MAX_REBASE_ATTEMPTS=3
# Agent runs that crash or produce no valid result (NOT usage-limit pauses) per ticket.
MAX_AGENT_FAILURES=2

# --- Throughput limits ---
# Max issues the BA may create in one run.
MAX_BA_ISSUES_PER_RUN=10
# Number of Devs working in parallel (1-3). Roles are enabled in DEV_ROLES_PRIORITY order.
MAX_PARALLEL_DEVS=3
# Order in which Dev roles are enabled when MAX_PARALLEL_DEVS < 3.
DEV_ROLES_PRIORITY=dev-fullstack,dev-be,dev-fe
# Max Dev agent runs per role per UTC day (plan + implement count as one run).
MAX_DEV_RUNS_PER_DAY=8
# Resume sweep only touches tickets that have been idle at least this many minutes.
RESUME_STALE_MINUTES=20

# --- Models (Claude Pro subscription) ---
MODEL_BA=claude-opus-5-5
MODEL_DEV_PLAN=claude-opus-5-5
MODEL_DEV_IMPLEMENT=claude-sonnet-5-5
MODEL_TECH_LEAD=claude-sonnet-5-5
MODEL_TESTER=claude-sonnet-5-5

# --- Max agentic turns per run ---
TURNS_BA=60
TURNS_TECH_LEAD=40
TURNS_DEV_PLAN=40
TURNS_DEV_IMPLEMENT=150
TURNS_TESTER=40
