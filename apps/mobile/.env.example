# Copy to a local env file (never commit it). Placeholders only: no secrets belong in the app.
# Base URL of the MoneyMates Django API.
EXPO_PUBLIC_API_URL=https://api.example.invalid
# 1 = swap in E2E mock adapters (scanner, voice, AI, bank opener); 0 in production.
EXPO_PUBLIC_E2E=0
# Shared app secret sent as X-App-Secret (same value as the server's APP_SHARED_SECRET). Placeholder only.
EXPO_PUBLIC_APP_SECRET=replace-me
