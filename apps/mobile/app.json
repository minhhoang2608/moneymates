{
  "expo": {
    "name": "MoneyMates",
    "slug": "moneymates",
    "version": "0.1.0",
    "scheme": "moneymates",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.moneymates.app"
    },
    "android": {
      "package": "com.moneymates.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C66"
      }
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-camera",
        { "cameraPermission": "MoneyMates cần camera để quét mã QR thanh toán.", "recordAudioAndroid": false }
      ],
      ["expo-image-picker", { "photosPermission": "MoneyMates cần truy cập thư viện ảnh để bạn chọn ảnh đại diện và ảnh đính kèm giao dịch." }],
      "@react-native-community/datetimepicker"
    ]
  }
}
