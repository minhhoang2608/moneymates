{
  "expo": {
    "name": "MoneyMates",
    "slug": "moneymates",
    "version": "0.1.0",
    "scheme": "moneymates",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.moneymates.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["hydro", "mbbank", "momo", "tcb", "vietcombankmobile", "vietinbankipay"]
      }
    },
    "android": {
      "package": "com.moneymates.app",
      "permissions": ["READ_MEDIA_IMAGES", "WRITE_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C66"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "MoneyMates cần camera để quét mã QR thanh toán.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MoneyMates cần truy cập thư viện ảnh để bạn chọn ảnh đại diện và ảnh đính kèm giao dịch."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MoneyMates cần truy cập ảnh để lưu mã QR trước khi mở app ngân hàng.",
          "savePhotosPermission": "MoneyMates cần quyền lưu ảnh để lưu mã QR vào thư viện.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MoneyMates cần micro để bạn nhập giao dịch bằng giọng nói.",
          "speechRecognitionPermission": "MoneyMates cần nhận dạng giọng nói để chuyển lời bạn nói thành giao dịch."
        }
      ],
      [
        "./plugins/withAndroidQueries",
        { "schemes": ["hydro", "mbbank", "momo", "tcb", "vietcombankmobile", "vietinbankipay"] }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MoneyMates dùng Face ID để mở khóa ứng dụng."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": ["image/*"],
          "androidMultiIntentFilters": [],
          "disableIOS": false,
          "iosAppGroupIdentifier": "group.com.moneymates.app"
        }
      ]
    ]
  }
}
