<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="image/png" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="image/jpeg" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- Bank and wallet apps MoneyMates opens (Android 11+ package visibility). -->
    <package android:name="vn.com.techcombank.bb.app" />
    <package android:name="com.tpb.mb.gprsandroid" />
    <package android:name="com.VCB" />
    <package android:name="com.mbmobile" />
    <package android:name="com.vietinbank.ipay" />
    <package android:name="com.mservice.momotransfer" />
    <package android:name="com.sacombank.ewallet" />
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="tcb" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="hydro" />
    </intent>
  </queries>
  <application>
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.bankhandoff.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/bank_hand_off_paths" />
    </provider>
  </application>
</manifest>
