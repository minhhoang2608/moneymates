DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost
# URL-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL=postgres://account_moneymates:password@localhost:5432/account_moneymates
# Empty means auto: db cache with PostgreSQL, LocMem otherwise (db or locmem to force).
CACHE_BACKEND=
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
OPENROUTER_VISION_MODELS=
AI_BILL_MAX_BYTES=1500000
APP_SHARED_SECRET=
OPENROUTER_TIMEOUT_S=10
AI_LIMIT_PER_MINUTE=20
AI_LIMIT_PER_DAY=50
